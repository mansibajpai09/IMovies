PORT=5000
# Paste your MongoDB Connection URL below (Atlas Cloud or Local MongoDB):
# Cloud Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/imovies
MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/imovies?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
NODE_ENV=development
